APP_NAME="Protocol Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Database Configuration (Rule 7: Dual-Mode Topology)
# --------------------------------------------------------------------------
# Option A: Standalone Host Mode (SQLite - Zero Docker / Zero Dependency)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Option B: Containerized Mode (Docker PostgreSQL 17 on port 5433)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_DATABASE=protocol_platform
# DB_USERNAME=postgres
# DB_PASSWORD=secret

# --------------------------------------------------------------------------
# Cache, Session & Queue Drivers (Rule 3: Local Dev Simplicity)
# --------------------------------------------------------------------------
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# --------------------------------------------------------------------------
# API Authentication & Session Stateful Domains (Rule 1 & Rule 13)
# --------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DOMAIN=localhost

# --------------------------------------------------------------------------
# Search Engine Sidecar: Typesense (Rule 7 & Rule 14)
# --------------------------------------------------------------------------
# Driver: 'typesense' to enable search sidecar, or 'null' for direct SQL search
SCOUT_DRIVER=typesense

# Option A: Local Typesense Docker Container (port 8108, HTTP)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_ADMIN_API_KEY=xyz
TYPESENSE_SEARCH_ONLY_API_KEY=abc

# Option B: Typesense Cloud Cluster (port 443, HTTPS)
# TYPESENSE_HOST=your-cluster-url.a1.typesense.net
# TYPESENSE_PORT=443
# TYPESENSE_PROTOCOL=https
# TYPESENSE_ADMIN_API_KEY=your_secret_admin_key_here
# TYPESENSE_SEARCH_ONLY_API_KEY=your_search_only_key_here

